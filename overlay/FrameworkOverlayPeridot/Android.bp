//
// Must be product_specific: NavigationBarModeGesturalOverlay is also product,
// and product RROs win over vendor RROs for the same android resource. A vendor
// FrameworkOverlayPeridot with priority 100 still lost to gestural's 30dp
// (90px on peridot), which pilfers Telegram/WhatsApp swipe-to-reply.
//

runtime_resource_overlay {
    name: "FrameworkOverlayPeridot",
    product_specific: true,
}
