<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- BestROM: dark theme out of the box. 2 = UiModeManager.MODE_NIGHT_YES -->
    <integer name="config_defaultNightMode">2</integer>
    <!-- BestROM: show the battery percentage in the status bar by default. -->
    <bool name="config_defaultBatteryPercentageSetting">true</bool>
    <!-- BestROM: keep far more call history per SIM than the 500-entry default. -->
    <integer name="config_maximumCallLogEntriesPerSim">10000</integer>

    <!-- BestROM: no window blur. Pairs with TARGET_ENABLE_BLUR := false in
         bestrom_peridot.mk, which clears ro.surface_flinger.supports_background_blur.
         These two bools are the framework-side gates for the app-launch blur and the
         shade-expansion blur; leaving them true would keep asking for a blur the
         compositor no longer supports. -->
    <bool name="config_enableAppLaunchBlur">false</bool>
    <bool name="config_enableBlurExpansion">false</bool>

    <!-- BestROM typography. Space Grotesk reads, Doto is glanced at.
         These are the platform defaults, not a lock: the Settings font picker's
         overlays are mutable and unconfigured, so OverlayConfig hands them
         DEFAULT_PRIORITY (Integer.MAX_VALUE) and OverlayManagerSettings.insert puts
         them after this static priority-100 overlay, i.e. above it. Picking a font in
         Settings still wins; picking none comes back here.
         config_clockFontFamily deliberately lives here rather than in a font overlay -
         none of the fifteen stock font overlays sets it, so the dot-matrix clock
         survives a change of body font instead of silently reverting. The two fonts
         are installed to /product/fonts and declared as named families in
         /product/etc/fonts_customization.xml. -->
    <string name="config_bodyFontFamily" translatable="false">space-grotesk</string>
    <string name="config_bodyFontFamilyMedium" translatable="false">space-grotesk-medium</string>
    <string name="config_headlineFontFamily" translatable="false">space-grotesk</string>
    <string name="config_headlineFontFamilyMedium" translatable="false">space-grotesk-medium</string>
    <string name="config_clockFontFamily" translatable="false">doto</string>

    <!-- BestROM: monochrome is also the style the setup wizard seeds. Without this
         the SystemUI default is quietly undone on a clean flash: when
         hardwareColorStyles() is on and the user is not yet provisioned,
         ThemeOverlayController.start() reads this array, assigns
         mThemeStyle = defaultSettings.style and then WRITES that style into
         Settings.Secure.THEME_CUSTOMIZATION_OVERLAY_PACKAGES, which from then on
         outranks the compiled-in default for the life of the install. AOSP's only
         entry is the wildcard "*|TONAL_SPOT|home_wallpaper"; peridot has no
         ro.boot.hardware.color variants to enumerate, so the wildcard is the whole
         array. Seed colour source is unchanged - still the home wallpaper. -->
    <string-array name="theming_defaults" translatable="false">
        <item>*|MONOCHROMATIC|home_wallpaper</item>
    </string-array>

    <!-- BestROM: vibration off out of the box. 0 = Vibrator.VIBRATION_INTENSITY_OFF.
         Runtime fallbacks: VibrationSettings.updateSettings loads each
         Settings.System.*_VIBRATION_INTENSITY with -1 and falls back here, so they
         also apply on a dirty flash while the user has not touched the slider.
         Sliders stay available (SettingsOverlayPeridot keeps
         config_vibration_supported_intensity_levels = 3).
         config_defaultHapticFeedbackIntensity is deliberately NOT set to 0: that
         would also silence accessibility and power-button/fingerprint haptics;
         touch feedback is off via def_haptic_feedback in the SettingsProvider RRO. -->
    <integer name="config_defaultRingVibrationIntensity">0</integer>
    <integer name="config_defaultNotificationVibrationIntensity">0</integer>
    <integer name="config_defaultAlarmVibrationIntensity">0</integer>
    <integer name="config_defaultMediaVibrationIntensity">0</integer>
</resources>
