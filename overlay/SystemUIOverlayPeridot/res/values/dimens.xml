<resources>
    <dimen name="keyguard_indication_margin_bottom">145dp</dimen>

    <!-- Location on the screen of the center of the physical power button. This is a reasonable
    default that should be overridden by device-specific overlays. -->
    <dimen name="physical_power_button_center_screen_location_y">1210px</dimen>

    <!-- Microns/ums (1000 um = 1mm) per pixel for the given device. If unspecified, UI that
         relies on this value will not be sized correctly. -->
    <item name="pixel_pitch" type="dimen" format="float">56.96</item>

    <!-- BestROM: quick settings tiles as full pills, on and off alike. The inactive
         tile is already a pill (common_tile_default_inactive_tile_corner_radius points
         at the 50dp icon radius, clamped to half the tile height); only the active
         tile was a 24dp rounded rect. common_tile_default_tile_height is 72dp, so 36dp
         is exactly half and gives a true pill. Same RoundRect draw, marginally fewer
         lit corner pixels.
         NOTE: qs_corner_radius (28dp) is NOT the tile radius in A17 - it is only the
         top radius of qs_footer_actions_background - so it is deliberately left alone. -->
    <dimen name="common_tile_default_active_tile_corner_radius">36dp</dimen>

    <!-- BestROM: notification card radius. The platform has one value for the shade and
         the lock screen; the design asks for 24 in the shade and 20 on the lock screen,
         so take the shade number. -->
    <dimen name="notification_corner_radius">24dp</dimen>
</resources>
