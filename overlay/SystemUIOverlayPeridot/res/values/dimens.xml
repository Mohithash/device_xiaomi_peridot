<resources>
    <!-- Sit above the 280dp UDFPS recognizing animation around the optical
         sensor (y≈2437). 96dp still overlapped the art; 160dp clears it while
         leaving the PIN bouncer reachable without a hard scroll. -->
    <dimen name="keyguard_indication_margin_bottom">160dp</dimen>

    <!-- Slightly smaller than Voltage's 280dp default so the recognizing
         animation does not climb as far into the indication area. -->
    <dimen name="udfps_animation_size">200dp</dimen>
    <dimen name="udfps_animation_offset">0dp</dimen>

    <!-- Location on the screen of the center of the physical power button. This is a reasonable
    default that should be overridden by device-specific overlays. -->
    <dimen name="physical_power_button_center_screen_location_y">1210px</dimen>

    <!-- Fallback when AuthController has no HAL UDFPS bounds yet. AOSP default
         is 610px (rear-FPS placeholder); peridot sensor is at y=2437. -->
    <dimen name="physical_fingerprint_sensor_center_screen_location_y">2437px</dimen>

    <!-- Microns/ums (1000 um = 1mm) per pixel for the given device. If unspecified, UI that
         relies on this value will not be sized correctly. -->
    <item name="pixel_pitch" type="dimen" format="float">56.96</item>

    <!-- BestROM: quick settings tiles as full pills, on and off alike. The inactive
         tile is already a pill (common_tile_default_inactive_tile_corner_radius points
         at the 50dp icon radius, clamped to half the tile height); only the active
         tile was a 24dp rounded rect. common_tile_default_tile_height is 72dp, so 36dp
         is exactly half and gives a true pill. Same RoundRect draw, marginally fewer
         lit corner pixels.
         NOTE: qs_corner_radius (28dp) is NOT the tile radius in A17 - it is only the
         top radius of qs_footer_actions_background - so it is deliberately left alone. -->
    <dimen name="common_tile_default_active_tile_corner_radius">36dp</dimen>
    <!-- Match inactive tile + icon radii so on/off look identical (Nothing-like pills). -->
    <dimen name="common_tile_default_inactive_tile_corner_radius">36dp</dimen>
    <dimen name="common_tile_default_active_icon_corner_radius">36dp</dimen>
    <dimen name="common_tile_default_inactive_icon_corner_radius">36dp</dimen>

    <!-- BestROM: notification card radius. The platform has one value for the shade and
         the lock screen; the design asks for 24 in the shade and 20 on the lock screen,
         so take the shade number. -->
    <dimen name="notification_corner_radius">24dp</dimen>

    <!-- BestROM: the shutdown screen is a ScrimDrawable painted at this alpha
         over whatever was on screen, so at 0.95 five per cent of the launcher
         or the last app keeps compositing through it for the whole shutdown.
         Make it opaque. TvSystemUI already ships 1.0. -->
    <item name="shutdown_scrim_behind_alpha" format="float" type="dimen">1.0</item>
</resources>
