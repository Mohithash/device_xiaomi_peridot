// SPDX-License-Identifier: Apache-2.0
//
// A soong module cannot be "un-inherited" from a product, but a module that
// overrides: it replaces it, and this one installs nothing. So listing a name
// here removes it from the build. Mechanism proof: Traceur (added by AOSP's
// handheld_system.mk:74) is listed and is absent from installed-files, while
// BasicDreams/BookmarkProvider/CaptivePortalLogin from the same makefile are
// not listed and do ship.
//
// Two checks are required before adding a name here.
//
//  1. OUTBOUND: the module exists in
//     out/target/product/peridot/all_modules.txt. An entry naming a module
//     that does not exist is a silent no-op, which is how this list
//     previously accumulated 34 dead GApps/carrier entries inherited from
//     somebody else's debloat list.
//
//  2. INBOUND: every surviving caller of the package must either resolve it
//     before offering the entry point, or tolerate its absence. The test is
//     NOT "does anything reference the package" -- plenty of guarded
//     references are harmless. The test is whether an UNGUARDED reference
//     survives. Grep the ApplicationId (not the Soong module name) across
//     packages/apps/Settings/src AND res/xml, packages/apps/Powerhub,
//     frameworks/base/services, frameworks/base/core, and config_*/default-app
//     resources, then read each hit: a PreferenceController whose
//     getAvailabilityStatus() calls resolveActivity/queryIntentActivities is
//     safe; one that returns AVAILABLE unconditionally and then
//     startActivity()s is a crash. A bare <intent> inside a res/xml
//     <Preference> is a crash too - the click is consumed before it reaches
//     DashboardFragment's catalyst intent guard.
//
//     LogViewer (app.grapheneos.logviewer) passed check 1 and failed check 2:
//     LogcatLinkPrefController.getAvailabilityStatus() returned
//     ExtSettingControllerHelper.getGlobalSettingAvailability(), which only
//     asks whether this is the system user, and then
//     handlePreferenceTreeClick() startActivity()d LogViewerApp
//     .getLogcatIntent(). Settings died with ActivityNotFoundException on
//     every tap of System > View logs. It is no longer removed; see below.
//     OmniJaws (org.omnirom.omnijaws) failed check 2 the same way, via a bare
//     <intent> in packages/apps/Powerhub/res/xml/powerhub_lockscreen_weather
//     .xml; that one is now guarded in LockScreenWeatherSettings.java.
//
//     Inbound audit of the remaining entries (done, do not repeat):
//       DeviceDiagnostics - GUARDED. DeviceDiagnosticsPreferenceController.kt
//                           getIntent() resolveActivity()s and
//                           getAvailabilityStatus() returns
//                           UNSUPPORTED_ON_DEVICE. Row disappears.
//       EmergencyInfo     - GUARDED. EmergencyInfoPreferenceController.java
//                           queryIntentActivities, returns
//                           UNSUPPORTED_ON_DEVICE.
//       PrintSpooler / BuiltInPrintService / PrintRecommendationService
//                         - SAFE. PrintSettingPreferenceController.java gates
//                           on FEATURE_PRINTING, and the row opens an
//                           in-Settings fragment, not an external activity.
//                           Degrades to an empty print-services list.
//       Traceur           - SAFE. Zero references in packages/apps/Settings;
//                           its developer-options entry ships inside Traceur.
//       AppDataBackup     - the Settings row that pointed at
//                           com.android.appdatabackup was a bare <intent> in
//                           res/xml/apps.xml and has been deleted.

cc_prebuilt_binary {
    name: "RemovePackagesPeridot",
    srcs: ["RemovePackagesPeridot"],
    check_elf_files: false,
    strip: {
        none: true,
    },
    overrides: [
        // --- VoltageOS easter egg: compiled APK with "VoltageOS" strings, cannot be rebranded ---
        "VoltageJump",
        // --- AOSP handheld_system.mk / telephony extras ---
        "AvatarPicker",
        "BuiltInPrintService",
        "DeviceAsWebcam",
        "DeviceDiagnostics",
        "EmergencyInfo",
        "PrintRecommendationService",
        "PrintSpooler",
        "QuickSearchBox",
        "SimAppDialog",
        "Traceur",
        "WfdService",

        // --- VoltageOS extras (vendor/voltage/config/packages.mk) ---
        // These ship regardless of common_mobile vs common_full_phone, because
        // common.mk:267 includes packages.mk unconditionally.
        "Covers",             // cover-screen UI; peridot is not a foldable
        "Etar",               // calendar
        "GameSpace",          // game mode overlay
        "Gramophone",         // music player
        "Jellyfish",          // live wallpaper
        "LMOFreeform",        // freeform windowing
        "LMOFreeformSidebar",
        "OmniJaws",           // weather provider
        "AppDataBackup",
        "ExactCalculator",

        // Deliberately NOT removed, though they are Voltage extras:
        //   Glimpse        - the only gallery. MiuiCamera's thumbnail tap pins
        //                    com.miui.gallery first, misses, and retries a plain
        //                    ACTION_VIEW image/* that only Glimpse's ViewActivity
        //                    takes; Glimpse also holds the SYSTEM_GALLERY role
        //                    (config_systemGallery in packages/apps/Glimpse/
        //                    rro_overlays/GlimpseFrameworksBaseOverlay).
        //   (Aperture is no longer listed here: PRODUCT_NO_CAMERA := true in
        //    bestrom_peridot.mk already keeps it out of the build - see the
        //    ifneq in vendor/voltage/config/packages.mk. MiuiCamera
        //    (com.android.camera, from device/xiaomi/peridot-miuicamera/device.mk,
        //    inherited by our device.mk) is now the ONLY package in the image
        //    declaring IMAGE_CAPTURE / STILL_IMAGE_CAMERA, so it must never be
        //    added to this overrides list.)
        //   Seedvault      - the restore path the setup wizard offers
        //   ThemePicker    - backs Settings > Wallpaper & style
        //   ThemesStub
        //   Datura         - firewall; privacy-relevant, deliberately kept
        //   BestromSetupWizard - packages/apps/SetupWizard defines this and
        //                    there is no other setup wizard in the tree, so
        //                    removing it means no first-boot flow at all.
        //                    It is rebranded via overlay instead.
        //   Updater        - wanted for BestROM OTA; see vendor/bestrom.
        //   LogViewer      - Settings res/xml/system_dashboard_fragment.xml:174-178
        //                    ("View logs") and src/com/android/settings/spa/app/appinfo/
        //                    AppLogcatPreference.kt (App info > View logs) both launch an
        //                    intent hard-pinned to app.grapheneos.logviewer
        //                    (frameworks/base/core/java/android/ext/LogViewerApp.java:50-54),
        //                    and system_server's error/tombstone notifications target it
        //                    too (frameworks/base/services/core/java/com/android/server/ext/
        //                    {SystemErrorNotification,TombstoneHandler,DropBoxMonitor,
        //                    SystemJournalNotif}.java). Removing it made Settings throw
        //                    ActivityNotFoundException on tap.
    ],
}
